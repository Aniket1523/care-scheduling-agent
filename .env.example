# LLM configuration - variable names only. Never commit real values.
# The app reads these directly from the environment; this file is documentation, not loaded.
# In Windows CMD:  set LLM_API_KEY=...
LLM_API_KEY=
# Optional (defaults shown)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
